# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
BASE_URL=http://localhost:8000

# Storage
STORAGE_DIR=./storage

# Optional Footage API Keys (leave empty to use high-speed procedural MockProvider)
PEXELS_API_KEY=
PIXABAY_API_KEY=
ENABLE_MOCK_FOOTAGE=true

# Webhook Cryptographic Secret (HMAC-SHA256)
WEBHOOK_SECRET=frameflow_default_secret_key_2026

# Concurrency & Performance
MAX_CONCURRENT_JOBS=4
JOB_RETRIES=2
