# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
BASE_URL=http://localhost:8000

# Local Storage Directory
STORAGE_DIR=./storage

# S3 / MinIO Object Storage (Optional, leaves empty for local disk storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=frameflow-deliverables
S3_REGION=us-east-1
S3_USE_SSL=false

# Database Configuration (Postgres or SQLite fallback)
DATABASE_URL=sqlite:///./storage/frameflow.db

# Speech & AI Providers (Zero-API-Key Mocks available for testing)
ASR_PROVIDER=faster-whisper
ASR_MODEL_SIZE=base
ASR_DEVICE=cpu

TTS_PROVIDER=gtts
RELEVANCE_SCORER=clip
SMART_CROP_METHOD=saliency

# Optional External Footage API Keys (leave empty to use high-speed procedural MockProvider)
PEXELS_API_KEY=
PIXABAY_API_KEY=
ENABLE_MOCK_FOOTAGE=true

# Runtime switch to disable providers for fallback testing (e.g. "pexels,pixabay")
DISABLE_PROVIDER=

# Webhook Cryptographic Secret (HMAC-SHA256, auto-generated if left blank)
WEBHOOK_SECRET=

# Concurrency & Scene Constraints
MAX_CONCURRENT_JOBS=4
JOB_RETRIES=2
MIN_SCENE_DURATION=2.5
MAX_SCENE_DURATION=10.0
MAX_AUDIO_DURATION_SECONDS=600.0
